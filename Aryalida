<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Our Moments ❤️</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&family=Great+Vibes&display=swap" rel="stylesheet">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Poppins,sans-serif;
    background:linear-gradient(180deg,#090909,#141414,#1f1f1f);
    color:white;
    overflow-x:hidden;
}

/* Floating Heart */
.heart{
    position:fixed;
    bottom:-20px;
    color:#ff5fa2;
    animation:float 8s linear infinite;
    opacity:.7;
    pointer-events:none;
}
@keyframes float{
    from{transform:translateY(0) scale(.5);}
    to{transform:translateY(-120vh) scale(1.4);}
}

/* Hero */
.hero{
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:20px;
    background:
    linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.55)),
    url("https://cdn.imagetourls.com/uploads/tyImg/ElFOmY42.jpg") center/cover;
    animation:zoomHero 15s ease-in-out infinite alternate;
}

@keyframes zoomHero{
    from{background-size:100%;}
    to{background-size:110%;}
}

.hero h1{
    font-family:"Great Vibes",cursive;
    font-size:68px;
    animation:fadeDown 1.5s;
}

.hero p{
    margin-top:10px;
    font-size:18px;
    opacity:.9;
    animation:fadeUp 2s;
}

@keyframes fadeDown{
    from{opacity:0;transform:translateY(-40px);}
    to{opacity:1;transform:translateY(0);}
}

@keyframes fadeUp{
    from{opacity:0;transform:translateY(40px);}
    to{opacity:1;transform:translateY(0);}
}

/* Section */
section{
    padding:70px 20px;
}

.title{
    text-align:center;
    font-size:35px;
    margin-bottom:35px;
}

/* Gallery */
.gallery{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:18px;
}

.card{
    overflow:hidden;
    border-radius:20px;
    position:relative;
    background:#111;
    box-shadow:0 0 25px rgba(255,90,150,.15);
    transition:.4s;
    animation:appear 1s;
}

.card:hover{
    transform:translateY(-8px);
    box-shadow:0 0 35px rgba(255,90,150,.35);
}

.card img{
    width:100%;
    height:330px;
    object-fit:cover;
    transition:1s;
}

.card:hover img{
    transform:scale(1.08);
}

.card span{
    position:absolute;
    bottom:0;
    width:100%;
    padding:12px;
    text-align:center;
    background:linear-gradient(transparent,rgba(0,0,0,.85));
}

@keyframes appear{
    from{opacity:0;transform:translateY(30px);}
    to{opacity:1;transform:translateY(0);}
}

/* Slideshow */
.slider{
    width:100%;
    max-width:850px;
    margin:auto;
    overflow:hidden;
    border-radius:25px;
    box-shadow:0 0 35px rgba(255,90,150,.25);
}

.slides{
    display:flex;
    width:600%;
    animation:slide 24s infinite;
}

.slides img{
    width:100%;
    flex:1 0 100%;
    height:500px;
    object-fit:cover;
}

@keyframes slide{
0%,12%{transform:translateX(0);}
16%,28%{transform:translateX(-100%);}
32%,44%{transform:translateX(-200%);}
48%,60%{transform:translateX(-300%);}
64%,76%{transform:translateX(-400%);}
80%,92%{transform:translateX(-500%);}
100%{transform:translateX(0);}
}

/* Love Letter */
.letter{
    max-width:750px;
    margin:auto;
    background:rgba(255,255,255,.05);
    padding:30px;
    border-radius:22px;
    backdrop-filter:blur(12px);
    text-align:center;
    line-height:1.9;
    border:1px solid rgba(255,255,255,.08);
    animation:appear 1.5s;
}

/* Footer */
footer{
    text-align:center;
    padding:30px;
    color:#bbb;
}

@media(max-width:600px){
.hero h1{font-size:48px;}
.slides img{height:320px;}
}
</style>
</head>

<body>

<div id="hearts"></div>

<div class="hero">
<div>
